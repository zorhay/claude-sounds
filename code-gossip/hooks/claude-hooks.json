{
  "Stop": [{"hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh stop", "timeout": 5}]}],
  "StopFailure": [{"hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh error", "timeout": 5}]}],
  "PermissionRequest": [{"hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh permission", "timeout": 5}]}],
  "SessionStart": [{"hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh session_start", "timeout": 5}]}],
  "PostCompact": [{"hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh compact", "timeout": 5}]}],
  "SubagentStart": [{"hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh subagent_start", "timeout": 5}]}],
  "SubagentStop": [{"hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh subagent_stop", "timeout": 5}]}],
  "PostToolUseFailure": [{"hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh error", "timeout": 5}]}],
  "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh user_prompt", "timeout": 5}]}],
  "PreToolUse": [
    {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh edit", "timeout": 5}]},
    {"matcher": "Grep|Glob", "hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh search", "timeout": 5}]}
  ],
  "PostToolUse": [
    {"matcher": "Bash", "hooks": [{"type": "command", "command": "~/.code-gossip/engine/play.sh bash", "timeout": 5}]}
  ]
}
